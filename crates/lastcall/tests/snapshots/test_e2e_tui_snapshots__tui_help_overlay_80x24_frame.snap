source: crates/lastcall/tests/test_e2e_tui_snapshots.rs
expression: frame
---
"lastca┌ keys ────────────────────────────────────────────────────────────┐hing W"
"┌─────│ ↑ / k          previous entry / scroll up                        │─────┐"
"│alpha│ ↓ / j          next entry / scroll down                          │file]│"
"│  mai│ PgUp / b       page up                                           │flag]│"
"│  M f│ PgDn / Space   page down                                         │     │"
"│  M f│ Home           first entry / top of the diff                     │     │"
"│  M p│ End            last entry / end of the diff                      │     │"
"│─────│ Alt-↑ / {      previous repository                               │     │"
"│beta │ Alt-↓ / }      next repository                                   │     │"
"│  mai│ ⏎ / l / →      open the diff                                     │     │"
"│  A u│ Esc / h / ←    back to the file list (close help)                │     │"
"│  A u│ Tab            toggle focus                                      │     │"
"│  ups│ n / ]          next hunk                                         │     │"
"│─────│ p / [          previous hunk                                     │     │"
"│notes│ t              hide / show empty repos                           │     │"
"│  dra│ a              accept the hunk or the selected entry             │     │"
"│  M n│ A              accept the whole file                             │     │"
"│     │ … 22 more keys (100 columns shows all)                           │     │"
"│     │ q / Ctrl-C     quit                                              │     │"
"│     │ ^J is a newline in the note (⇧⏎ needs a kitty-protocol terminal) │     │"
"│     │ shift+drag selects text (mouse capture is on) · v/y copies       │     │"
"│     │ lastcall tui --tour shows the welcome again                      │     │"
"└─────│ any key closes                                                   │─────┘"
"↑↓ sel└──────────────────────────────────────────────────────────────────┘      "
