source: crates/lastcall/tests/test_e2e_tui_snapshots.rs
expression: frame
---
"lastca┌ keys ────────────────────────────────────────────────────────────┐hing W"
"┌─────│ ↑ / k          previous entry / scroll up                        │─────┐"
"│alpha│ ↓ / j          next entry / scroll down                          │file]│"
"│  mai│ PgUp / b       page up                                           │flag]│"
"│  M f│ PgDn / Space   page down                                         │     │"
"│  M f│ ⏎ / l / →      open the diff                                     │     │"
"│  M p│ Esc / h / ←    back to the file list (close help)                │     │"
"│─────│ Tab            toggle focus                                      │     │"
"│beta │ n / ]          next hunk                                         │     │"
"│  mai│ p / [          previous hunk                                     │     │"
"│  A u│ e              expand a collapsed file                           │     │"
"│  A u│ f              full paths                                        │     │"
"│  ups│ o              show org/repo                                     │     │"
"│─────│ t              hide / show empty repos                           │     │"
"│notes│ s              snooze this repo for a while                      │     │"
"│  dra│ S              show / hide snoozed repos                         │     │"
"│  M n│ a              accept the hunk or the selected entry             │     │"
"│     │ A              accept the whole file                             │     │"
"│     │ … 17 more keys (100 columns shows all)                           │     │"
"│     │ q / Ctrl-C     quit                                              │     │"
"│     │ ^J is a newline in the note (⇧⏎ needs a kitty-protocol terminal) │     │"
"│     │ shift+drag selects text (mouse capture is on) · v/y copies       │     │"
"└─────│ any key closes                                                   │─────┘"
"↑↓ sel└──────────────────────────────────────────────────────────────────┘      "
