"lastcall  3 repos · 5 files · 5 hunks  standalone  [Accept All]                           watching W"
"┌─────────────────────┌ keys ────────────────────────────────────────────────┐─────────────────────┐"
"│alpha                │ ↑ / k          previous entry / scroll up            │      [A accept file]│"
"│  main · 2 files     │ ↓ / j          next entry / scroll down              │           [a accept]│"
"│  M f1  +1 −1        │ PgUp / b       page up                               │                     │"
"│  M f2  +1 −0        │ PgDn / Space   page down                             │                     │"
"│─────────────────────│ ⏎ / l / →      open the diff                         │                     │"
"│beta                 │ Esc / h / ←    back to the file list (close help)    │                     │"
"│  main · 2 files     │ Tab            toggle focus                          │                     │"
"│  A u1  +1 −0  [upstr│ n / ]          next hunk                             │                     │"
"│  A u2  +2 −0  [mixed│ p / [          previous hunk                         │                     │"
"│  upstream · 1 file  │ f              full paths                            │                     │"
"│─────────────────────│ o              show org/repo                         │                     │"
"│notes                │ a              accept the hunk or the selected entry │                     │"
"│  draft · 1 file     │ A              accept the whole file                 │                     │"
"│  M n2.md  +2 −0     │ Ctrl-A         accept everything listed              │                     │"
"│                     │ d              ack the agent flag                    │                     │"
"│                     │ g              jump to the agent in herdr            │                     │"
"│                     │ w              workspace scope on/off                │                     │"
"│                     │ r              rescan now                            │                     │"
"│                     │ ?              this help                             │                     │"
"│                     │ q / Ctrl-C     quit                                  │                     │"
"│                     │ y / ⏎          confirm                               │                     │"
"│                     │ n / Esc        cancel                                │                     │"
"│                     │                                                      │                     │"
"│                     │ shift+drag selects text (mouse capture is on)        │                     │"
"│                     │                                                      │                     │"
"│                     │ any key closes                                       │                     │"
"└─────────────────────└──────────────────────────────────────────────────────┘─────────────────────┘"
