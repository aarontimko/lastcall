"│               │ a              accept the hunk or the selected entry             │               │"
"│               │ A              accept the whole file                             │               │"
"│               │ Ctrl-A         accept everything listed                          │               │"
"│               │ u              restore the hunk                                  │               │"
"│               │ U              restore the whole file                            │               │"
"│               │ z              undo the last accept                              │               │"
"│               │ m              flag it with a note                               │               │"
"│               │ M              clear the file's flags                            │               │"
"│               │ v              select lines                                      │               │"
"│               │ y              copy selection                                    │               │"
"│               │ i              edit in place                                     │               │"
"│               │ I              $EDITOR at the hunk                               │               │"
"│               │ d              ack the agent flag                                │               │"
"│               │ g              jump to the agent in herdr                        │               │"
"│               │ w              workspace scope on/off                            │               │"
"│               │ r              rescan now                                        │               │"
"│               │ ?              this help                                         │               │"
"│               │ q / Ctrl-C     quit                                              │               │"
"│               │ y / ⏎          confirm                                           │               │"
"│               │ n / Esc        cancel                                            │               │"
