"lastcall  3 repo┌ keys ────────────────────────────────────────────────────────────┐      watching W"
"┌───────────────│ ↑ / k          previous entry / scroll up                        │───────────────┐"
"│alpha          │ ↓ / j          next entry / scroll down                          │U restore file]│"
"│  main · 3 file│ PgUp / b       page up                                           │store] [m flag]│"
"│  M f1  +1 −1  │ PgDn / Space   page down                                         │               │"
"│  M f2  +1 −0  │ Home           first entry / top of the diff                     │               │"
"│  M parse.rs  +│ End            last entry / end of the diff                      │               │"
"│───────────────│ Alt-↑ / {      previous repository                               │               │"
"│beta           │ Alt-↓ / }      next repository                                   │               │"
"│  main · 2 file│ ⏎ / l / →      open the diff                                     │               │"
"│  A u1  +1 −0  │ Esc / h / ←    back to the file list (close help)                │               │"
"│  A u2  +2 −0  │ Tab            toggle focus                                      │               │"
"│  upstream · 1 │ n / ]          next hunk                                         │               │"
"│───────────────│ p / [          previous hunk                                     │               │"
"│notes          │ t              hide / show empty repos                           │               │"
"│  draft · 1 fil│ a              accept the hunk or the selected entry             │               │"
"│  M n2.md  +2 −│ A              accept the whole file                             │               │"
"│               │ Ctrl-A         accept everything listed                          │               │"
"│               │ u              restore the hunk                                  │               │"
"│               │ U              restore the whole file                            │               │"
"│               │ z              undo the last accept                              │               │"
"│               │ m              flag it with a note                               │               │"
"│               │ M              clear the file's flags                            │               │"
"│               │ v              select lines                                      │               │"
"│               │ y              copy selection                                    │               │"
"│               │ i              edit in place                                     │               │"
"│               │ I              $EDITOR at the hunk                               │               │"
"│               │ d              ack the agent flag                                │               │"
"│               │ g              jump to the agent in herdr                        │               │"
"│               │ w              workspace scope on/off                            │               │"
"│               │ r              rescan now                                        │               │"
"│               │ e              expand a collapsed file                           │               │"
"│               │ f              full paths                                        │               │"
"│               │ o              show org/repo                                     │               │"
"│               │ s              snooze this repo                                  │               │"
"│               │ S              show / hide snoozed repos                         │               │"
"│               │ ?              this help                                         │               │"
"│               │ q / Ctrl-C     quit                                              │               │"
"│               │ y / ⏎          confirm                                           │               │"
"│               │ n / Esc        cancel                                            │               │"
"│               │                                                                  │               │"
"│               │ ^J is a newline in the note (⇧⏎ needs a kitty-protocol terminal) │               │"
"│               │ shift+drag selects text (mouse capture is on) · v/y copies       │               │"
"│               │ lastcall tui --tour shows the welcome again                      │               │"
"│               │                                                                  │               │"
"└───────────────│ any key closes                                                   │───────────────┘"
"↑↓ select  ⏎ ope└──────────────────────────────────────────────────────────────────┘uit             "
