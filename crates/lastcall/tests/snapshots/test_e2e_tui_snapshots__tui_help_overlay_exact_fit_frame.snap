source: crates/lastcall/tests/test_e2e_tui_snapshots.rs
expression: frame
---
"l┌ keys ─────────────────────────────────────────────────────────────────────────────────────────┐ W"
"┌│ ↑ / k          previous entry / scroll up           m              flag it with a note        │─┐"
"││ ↓ / j          next entry / scroll down             M              clear the file's flags     │ │"
"││ PgUp / b       page up                              v              select lines               │ │"
"││ PgDn / Space   page down                            y              copy selection             │ │"
"││ ⏎ / l / →      open the diff                        i              edit in place              │ │"
"││ Esc / h / ←    back to the file list (close help)   I              $EDITOR at the hunk        │ │"
"││ Tab            toggle focus                         d              ack the agent flag         │ │"
"││ n / ]          next hunk                            g              jump to the agent in herdr │ │"
"││ p / [          previous hunk                        w              workspace scope on/off     │ │"
"││ t              hide / show empty repos              r              rescan now                 │ │"
"││ a              accept the hunk under the cursor     e              expand a collapsed file    │ │"
"││ A              accept the whole file or repo        f              full paths                 │ │"
"││ Ctrl-A         accept everything listed             o              show org/repo              │ │"
"││ u              restore the hunk                     s              snooze this repo           │ │"
"││ U              restore the whole file               S              show / hide snoozed repos  │ │"
"││ z              undo the last accept                 ?              this help                  │ │"
"││ Home           first entry / top of diff            q / Ctrl-C     quit                       │ │"
"││ End            last entry / end of diff             y / ⏎          confirm                    │ │"
"││ Alt-↑ / {      previous repository                  n / Esc        cancel                     │ │"
"││ Alt-↓ / }      next repository                                                                │ │"
"││                                                                                               │ │"
"││ ^J is a newline in the note (⇧⏎ needs a kitty-protocol terminal)                              │ │"
"││ shift+drag selects text (mouse capture is on) · v/y copies                                    │ │"
"││ lastcall tui --tour shows the welcome again                                                   │ │"
"└│ any key closes                                                                                │─┘"
"↑└───────────────────────────────────────────────────────────────────────────────────────────────┘  "
