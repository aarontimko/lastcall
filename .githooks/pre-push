#!/usr/bin/env bash
# Every push must be green under the heavier checks the commit hook skips: the integration
# tier (real git) and the store-backed proptests at 64 cases (the unit tier runs 8).
# Exactly `just test-prepush`, so the sponsor can run it by hand. Enable with
# `just hooks-install`. git feeds the refs being pushed on stdin; nothing here reads them.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: just test-prepush (integration tier + PROPTEST_CASES=64 proptests)" >&2
just test-prepush
echo "pre-push: green" >&2
